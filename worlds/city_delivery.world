<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="city_delivery">

    <!-- Better default camera angle looking at the center -->
    <gui>
     <camera name="user_camera">
       <pose>0 -40 20 0 0.5 1.57</pose>
     </camera>
    </gui>
    
    <scene>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <ambient>0.85 0.85 0.85 1</ambient>
      <sky>
        <clouds><speed>12</speed></clouds>
      </sky>
      <background>0.35 0.35 0.35 1.0</background>
    </scene>

    <physics name='default_physics' default='0' type='ode'>
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <!-- Sun -->
    <light type="directional" name="sun">
      <pose>0 0 1000 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.4</direction>
    </light>

    <!-- Green Grass Ground Plane -->
    <model name="grass_ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Roads (Intersecting perfectly at 0,0) -->
    <road name="main_road_x">
      <width>8.0</width>
      <point>-40 0 0.015</point>
      <point>40 0 0.015</point>
      <material>
        <script>
          <uri>file://media/materials/scripts/gazebo.material</uri>
          <name>Gazebo/Residential</name>
        </script>
      </material>
    </road>

    <road name="main_road_y">
      <width>8.0</width>
      <point>0 -40 0.01</point>
      <point>0 40 0.01</point>
      <material>
        <script>
          <uri>file://media/materials/scripts/gazebo.material</uri>
          <name>Gazebo/Residential</name>
        </script>
      </material>
    </road>

    <!-- Buildings: Pulled up to the road edges -->
    <include>
      <name>supermarket_warehouse</name>
      <pose>16.27 21.23 0.0 0 0 1.57</pose>
      <uri>model://grocery_store</uri>
    </include>

    <include>
      <name>customer_house_1</name>
      <pose>-11 17.388 0.0 0 0 -1.57</pose>
      <uri>model://house_1</uri>
    </include>

    <include>
      <name>customer_house_2</name>
      <pose>-11.67 -11.617 0.0 0 0 1.57</pose>      <uri>model://house_2</uri>
    </include>

    <include>
      <name>customer_house_3</name>
      <pose>14.95 -8 0.0 0 0 3.14</pose>
      <uri>model://house_3</uri>
    </include>

    <include>
      <name>apartment_block</name>
      <pose>14.62 -29.175 0.0 0 0 3.14</pose>
      <uri>model://apartment</uri>
    </include>

    <!-- Trees: Landscaping along the streets -->
    <include><name>tree_1</name><pose>-26 28.4 0 0 0 0</pose><uri>model://oak_tree</uri></include>
    <include><name>tree_2</name><pose>-6 12 0 0 0 0</pose><uri>model://pine_tree</uri></include>
    <include><name>tree_3</name><pose>33.56 -12.162 0 0 0 0</pose><uri>model://oak_tree</uri></include>
    <include><name>tree_4</name><pose>8 -22 0 0 0 0</pose><uri>model://pine_tree</uri></include>
    <include><name>tree_5</name><pose>-20 -15 0 0 0 0</pose><uri>model://oak_tree</uri></include>
    <include><name>tree_6</name><pose>12 -38 0 0 0 0</pose><uri>model://pine_tree</uri></include>

    <!-- Vehicles: Parked tight to the curbs -->
    <include>
      <name>parked_hatchback_red</name>
      <pose>-10 3 0.01 0 0 0</pose>
      <uri>model://hatchback_red</uri>
    </include>

    <include>
      <name>parked_suv</name>
      <pose>12 -3 0.01 0 0 3.14</pose>
      <uri>model://suv</uri>
    </include>

    <include>
      <name>delivery_pickup</name>
      <pose>22 15 0.01 0 0 -1.57</pose>
      <uri>model://pickup</uri>
    </include>

    <!-- Moving Pedestrians (Actors) -->
    <!-- Pedestrian 1: Walking near the Supermarket -->
    <actor name="pedestrian_1">
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking"><filename>walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time><pose>5 5 0.01 0 0 0</pose></waypoint>
          <waypoint><time>5</time><pose>15 5 0.01 0 0 0</pose></waypoint>
          <waypoint><time>10</time><pose>5 5 0.01 0 0 3.14</pose></waypoint>
        </trajectory>
      </script>
    </actor>
    <!-- Visual Finish Line (Red Goal Marker on the road outside House 1) -->
        <model name="goal_marker">
          <static>true</static>
          <pose>-15.0 4.0 0.02 0 0 0</pose>
          <link name="link">
            <visual name="visual">
              <geometry><cylinder><radius>2.0</radius><length>0.05</length></cylinder></geometry>
              <material>
                <ambient>1 0 0 1</ambient>
                <diffuse>1 0 0 1</diffuse>
                <emissive>1 0 0 1</emissive>
              </material>
            </visual>
          </link>
        </model>
    <!-- Pedestrian 2: Crossing the main intersection -->
    <actor name="pedestrian_2">
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking"><filename>walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <delay_start>2.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time><pose>-5 -5 0.01 0 0 1.57</pose></waypoint>
          <waypoint><time>5</time><pose>-5 5 0.01 0 0 1.57</pose></waypoint>
          <waypoint><time>10</time><pose>-5 -5 0.01 0 0 -1.57</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Physical perimeter around the 80 m x 80 m training area -->
    <model name="training_area_boundary">
      <static>true</static>

      <!-- North boundary -->
      <link name="north_boundary">
        <pose>0 39.75 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>80 0.5 1.0</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- South boundary -->
      <link name="south_boundary">
        <pose>0 -39.75 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>80 0.5 1.0</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- East boundary -->
      <link name="east_boundary">
        <pose>39.75 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 80 1.0</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- West boundary -->
      <link name="west_boundary">
        <pose>-39.75 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 80 1.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>