<?xml version="1.0"?>
<sdf version="1.6">
  <world name="small_city_training">

    <!-- Compact training world for Group 34 Q-learning.
         All obstacles use simple collision geometry so that Gazebo and the laser
         sensor have less work to do than in the full city map. -->

    <gui>
      <camera name="user_camera">
        <pose>0 -18 14 0 0.55 1.57</pose>
      </camera>
    </gui>

    <scene>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <ambient>0.85 0.85 0.85 1</ambient>
      <background>0.45 0.55 0.65 1</background>
    </scene>

    <physics name="default_physics" default="1" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <light type="directional" name="sun">
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.8</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>24 16</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>24 16</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.20 0.42 0.18 1</ambient>
            <diffuse>0.20 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cross-shaped road: visuals only; the ground plane provides collision. -->
    <model name="road_surface">
      <static>true</static>
      <link name="horizontal_road">
        <pose>0 0 0.006 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>21 7 0.012</size></box></geometry>
          <material>
            <ambient>0.18 0.18 0.18 1</ambient>
            <diffuse>0.18 0.18 0.18 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="vertical_road">
        <pose>0 0 0.007 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>7 13 0.014</size></box></geometry>
          <material>
            <ambient>0.18 0.18 0.18 1</ambient>
            <diffuse>0.18 0.18 0.18 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="centre_line">
        <pose>0 0 0.016 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>18 0.08 0.012</size></box></geometry>
          <material>
            <ambient>0.95 0.80 0.08 1</ambient>
            <diffuse>0.95 0.80 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple perimeter buildings. They are visible, collidable and lightweight. -->
    <model name="north_west_building">
      <static>true</static>
      <pose>-7.5 5.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.0 2.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5.0 2.2 2.5</size></box></geometry>
          <material><ambient>0.62 0.48 0.34 1</ambient><diffuse>0.62 0.48 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="north_east_building">
      <static>true</static>
      <pose>7.5 5.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.0 2.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5.0 2.2 2.5</size></box></geometry>
          <material><ambient>0.52 0.40 0.30 1</ambient><diffuse>0.52 0.40 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_west_building">
      <static>true</static>
      <pose>-7.5 -5.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.0 2.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5.0 2.2 2.5</size></box></geometry>
          <material><ambient>0.55 0.35 0.30 1</ambient><diffuse>0.55 0.35 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_east_building">
      <static>true</static>
      <pose>7.5 -5.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.0 2.2 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5.0 2.2 2.5</size></box></geometry>
          <material><ambient>0.42 0.48 0.58 1</ambient><diffuse>0.42 0.48 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Two static road obstacles create a learnable S-shaped route.
         They do not completely block the road, so both left and right avoidance
         behaviours remain possible. -->
    <model name="parked_delivery_van">
      <static>true</static>
      <pose>1.5 1.35 0.50 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.4 1.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.4 1.2 1.0</size></box></geometry>
          <material><ambient>0.10 0.30 0.75 1</ambient><diffuse>0.10 0.30 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="roadworks_barrier">
      <static>true</static>
      <pose>-2.7 -1.35 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2 0.75 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.75 0.8</size></box></geometry>
          <material><ambient>0.95 0.35 0.05 1</ambient><diffuse>0.95 0.35 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Physical mobile obstacle.
         The existing mobile_obstacle_controller.py moves this model using
         /gazebo/set_model_state. Unlike a visual-only actor, this model has a
         collision cylinder that the laser scanner can detect. -->
    <model name="moving_pedestrian">
      <static>false</static>
      <pose>4.0 -2.4 0.50 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry><cylinder><radius>0.45</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.45</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.85 0.10 0.10 1</ambient><diffuse>0.85 0.10 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Start and goal markers are visual only. -->
    <model name="start_marker">
      <static>true</static>
      <pose>8.0 0.0 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.70</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.85 0.10 1</ambient>
            <diffuse>0.05 0.85 0.10 1</diffuse>
            <emissive>0.05 0.45 0.05 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="goal_marker">
      <static>true</static>
      <pose>-8.0 0.0 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.90</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.05 0.05 1</ambient>
            <diffuse>0.95 0.05 0.05 1</diffuse>
            <emissive>0.50 0.02 0.02 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Physical boundary around the 24 m x 16 m area. -->
    <model name="training_area_boundary">
      <static>true</static>

      <link name="north">
        <pose>0 7.75 0.50 0 0 0</pose>
        <collision name="collision"><geometry><box><size>24 0.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>24 0.5 1.0</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>

      <link name="south">
        <pose>0 -7.75 0.50 0 0 0</pose>
        <collision name="collision"><geometry><box><size>24 0.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>24 0.5 1.0</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>

      <link name="east">
        <pose>11.75 0 0.50 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.5 16 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 16 1.0</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>

      <link name="west">
        <pose>-11.75 0 0.50 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.5 16 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 16 1.0</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
