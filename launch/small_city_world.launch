<launch>
  <arg name="paused" default="false" />
  <arg name="use_sim_time" default="true" />
  <arg name="gui" default="true" />
  <arg name="headless" default="false" />
  <arg name="debug" default="false" />
  <arg name="mobile_obstacle" default="true" />

  <param name="use_sim_time" value="$(arg use_sim_time)" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find com760cw2_group34)/worlds/small_city_training.world" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="use_sim_time" value="$(arg use_sim_time)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="headless" value="$(arg headless)" />
    <arg name="debug" value="$(arg debug)" />
  </include>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find com760cw2_group34)/urdf/group34Bot.xacro'" />

  <!-- Spawn facing west, directly toward the fixed training goal. -->
  <node name="spawn_group34_bot"
        pkg="gazebo_ros"
        type="spawn_model"
        args="-urdf -model group34Bot -param robot_description -x 8.0 -y 0.0 -z 0.01 -Y 3.14159"
        output="screen" />

  <node name="robot_state_publisher"
        pkg="robot_state_publisher"
        type="robot_state_publisher"
        output="screen" />

  <!-- Uses the physical model named moving_pedestrian in the world file. -->
  <group if="$(arg mobile_obstacle)">
    <node name="mobile_obstacle_controller"
          pkg="com760cw2_group34"
          type="mobile_obstacle_controller.py"
          output="screen">
      <param name="model_name" value="moving_pedestrian" />
      <param name="x1" value="4.0" />
      <param name="y1" value="-2.4" />
      <param name="x2" value="4.0" />
      <param name="y2" value="2.4" />
      <param name="z" value="0.50" />
      <param name="speed" value="0.30" />
      <param name="rate_hz" value="20.0" />
    </node>
  </group>
</launch>
